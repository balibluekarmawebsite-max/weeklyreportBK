APP_NAME="BKDS Weekly Reports"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (zero setup). Leave as-is for local work.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# --- Production on Bluehost VPS: use MySQL instead ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bkds_reports
# DB_USERNAME=bkds_reports
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Groq AI (server-side only; see docs/PLAN.md section 5) ---
# Get a free key at https://console.groq.com/keys. Leave GROQ_API_KEY empty to
# keep AI features switched off (the app degrades gracefully without it).
GROQ_API_KEY=
# Pick a chat model your key can access (Groq Console -> Limits lists yours).
# openai/gpt-oss-120b is a strong writer on Groq's free tier.
GROQ_MODEL=openai/gpt-oss-120b
# Vision model for reading data out of uploaded screenshots (same key).
# Needs a vision-capable model; not available on every Groq tier.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=45

# --- VHP robot secure import endpoint (see docs/PLAN.md section 4 & 8) ---
# Shared secret the Playwright robot uses to sign uploads (HMAC). Generate a
# long random value (e.g. `php artisan key:generate --show`) and set the SAME
# value in tools/vhp-robot/.env. Leave empty to disable the endpoint (503).
VHP_IMPORT_SECRET=
# How old (seconds) a signed upload may be before it's rejected (replay guard).
VHP_IMPORT_TOLERANCE=300

# Default report language(s): en or en,id
REPORT_LANGUAGES=en
