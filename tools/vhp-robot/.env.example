# VHP robot configuration. Copy to .env and fill in. NEVER commit the real .env.
# This file lives only on the machine (or cloud runner) that runs the robot;
# the VHP password never reaches the dashboard.

# The dashboard's secure import endpoint.
DASHBOARD_IMPORT_URL=https://reports.yourdomain.com/api/vhp-import

# Shared secret — must EXACTLY match VHP_IMPORT_SECRET in the dashboard's .env.
VHP_IMPORT_SECRET=

# Which property this robot reports for.
PROPERTY_CODE=BKDS

# Optional: the report week's start date (YYYY-MM-DD). If omitted, the server
# derives it from the workbook file name.
# REPORT_START_DATE=2026-09-25

# --- VHP login (only needed for the full scrape; not for --file uploads) ---
VHP_URL=https://vhp.yourhotel.example/login
VHP_USERNAME=
VHP_PASSWORD=
# Run with a visible browser while setting up (true = headless for production).
HEADLESS=true
# Selectors — verify against VHP's real login form, then adjust if needed.
# VHP_USER_SELECTOR=input[name="username"]
# VHP_PASS_SELECTOR=input[name="password"]
# VHP_SUBMIT_SELECTOR=button[type="submit"]
